Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:content\.php|lib(?:/|$)) - [F,L,NC]
  RewriteRule ^artikel/([a-z0-9-]+)/?$ index.php?article=$1 [L,QSA]
</IfModule>

<FilesMatch "^(?:content\.php|.*\.(?:json|csv|md|log|bak|ini))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Cache-Control "no-store" "expr=%{CONTENT_TYPE} =~ m#^text/html#"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>
