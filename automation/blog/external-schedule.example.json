{
  "job": {
    "title": "Krankenfahrten – freigegebenen Ratgeber veröffentlichen",
    "enabled": false,
    "url": "https://api.github.com/repos/nasirahmad84-design/krankenfahrten-bad-homburg/actions/workflows/blog-manual.yml/dispatches",
    "saveResponses": false,
    "requestMethod": 1,
    "requestTimeout": 30,
    "redirectSuccess": false,
    "schedule": {
      "timezone": "Europe/Berlin",
      "expiresAt": 0,
      "hours": [9],
      "minutes": [0],
      "wdays": [1, 4],
      "mdays": [-1],
      "months": [-1]
    },
    "extendedData": {
      "headers": {
        "Accept": "application/vnd.github+json",
        "Content-Type": "application/json",
        "X-GitHub-Api-Version": "2026-03-10",
        "Authorization": "Bearer REPLACE_WITH_REPOSITORY_SCOPED_ACTIONS_TOKEN"
      },
      "body": "{\"ref\":\"main\",\"inputs\":{\"dry_run\":\"true\"}}"
    },
    "notification": {
      "onFailure": true,
      "onFailureCount": 1,
      "onSuccess": true,
      "onDisable": true
    }
  }
}
